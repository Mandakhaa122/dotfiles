* {
    /* Map your palette values */
    bg0:     #171412ff;
    bg1:     #25211eff; /* Sightly lighter accent background */
    fg0:     #FEF3C7ff;
    
    accent:  #C76A4Fff;
    urgent:  #B44F5Fff;
    select:  #C99A68ff;

    background-color:   transparent;
    text-color:         @fg0;
    margin:             0;
    padding:            0;
    spacing:            0;
}

window {
    background-color:   @bg0;
    border:             2px;
    border-color:       @accent;
    border-radius:      10px;
    width:              500px;
    padding:            20px;
}

inputbar {
    spacing:    12px;
    padding:    8px;
    background-color: @bg1;
    border-radius: 6px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: "Search applications...";
    text-color: @fg0;
}

listview {
    lines:      8;
    columns:    1;
    fixed-height: true;
    margin:     12px 0 0;
}

element {
    padding:    8px;
    spacing:    8px;
    border-radius: 4px;
}

element normal antique, element alternate antique {
    text-color: @fg0;
}

element selected normal, element selected active {
    background-color:   @select;
    text-color:         @bg0;
}

