{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": {
      "1": "yellow",
      "2": "yellow"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "yellow",
      "title": "yellow"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    "break",
    {
      "type": "os",
      "key": "  "
    },
    {
      "type": "kernel",
      "key": "  󰌽"
    },
    {
      "type": "packages",
      "key": "  󰏖"
    },
    {
      "type": "shell",
      "key": "  ❯_"
    },
    {
      "type": "terminal",
      "key": "  "
    },
    {
      "type": "wm",
      "key": "  󱂬"
    },
    {
      "type": "uptime",
      "key": "  󱎫"
    },
    {
      "type": "media",
      "key": "  󰝚"
    },
    "break",
    {
      "type": "colors",
      "symbol": "square"
    }
  ]
}
